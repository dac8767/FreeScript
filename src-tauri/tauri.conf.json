{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ScriptCraft",
  "version": "7.82.0",
  "identifier": "com.freedraft.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "ScriptCraft",
        "width": 480,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "ScriptCraft",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "maximized": true,
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost asset://localhost https://asset.localhost; script-src 'self' tauri://localhost https://accounts.google.com 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' tauri://localhost 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' tauri://localhost https://fonts.gstatic.com; img-src 'self' tauri://localhost asset://localhost https://asset.localhost https: data: blob:; connect-src 'self' tauri://localhost asset://localhost https://asset.localhost wss: ws: https:; frame-src https://airtable.com https://www.youtube-nocookie.com https://player.vimeo.com https://accounts.google.com blob:; media-src 'self' tauri://localhost asset://localhost https://asset.localhost blob:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "category": "public.app-category.productivity",
    "fileAssociations": [
      {
        "ext": [
          "fdx"
        ],
        "mimeType": "application/xml",
        "description": "Final Draft Script"
      },
      {
        "ext": [
          "fountain"
        ],
        "mimeType": "text/plain",
        "description": "Fountain Script"
      },
      {
        "ext": [
          "script"
        ],
        "mimeType": "application/json",
        "description": "ScriptCraft Script"
      },
      {
        "ext": [
          "odraft"
        ],
        "mimeType": "application/json",
        "description": "ScriptCraft Script (legacy .odraft)"
      },
      {
        "ext": [
          "txt"
        ],
        "mimeType": "text/plain",
        "description": "Text File"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/dac8767/ScriptCraft-releases/main/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MUI4QzEyMzRGQjdGNjYKUldSbWYvczBFb3diU2NqUmdPNUxnbmhpUEc2VzkwOHA0aWd5aDU4WkdIamVIRHd2aWd0YkV1bnIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
